<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme -->
    <style name="Theme.AetherFocus" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#050608</item>
    </style>

    <!-- Splash Screen Theme (Void Black #050608) -->
    <style name="Theme.AetherFocus.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#050608</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AetherFocus</item>
    </style>

    <!-- Fullscreen Intervention Theme (Cyberpunk Translucent/Fullscreen Overlay) -->
    <style name="Theme.AetherFocus.FullscreenIntervention" parent="Theme.AetherFocus">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>